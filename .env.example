SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
PORT=3000
NUDGE_AFTER_SECONDS=120
GIVE_UP_AFTER_SECONDS=240
DEMO_MODE=true
# Demo seed (npm run seed): two teammates' phones, E.164, both must have texted the agent before
SEED_ORGANIZER_PHONE=
SEED_ORGANIZER_NAME=Priya
SEED_MEMBER_PHONE=
SEED_MEMBER_NAME=Sam
# The agent's iMessage number (E.164). Enables tap-to-join links and the QR code on the board.
AGENT_NUMBER=
# true only if Photon gives you a dedicated line (one number for everyone). Turns on invite links + QR.
DEDICATED_LINE=false
# cloud = Photon lines (shared pool cannot text people first). local = this Mac's Messages app via Spectrum (can).
IMESSAGE_MODE=cloud
# Website (+ new trip, trip links). TUNNEL=true starts a free cloudflared tunnel so links work on phones.
TUNNEL=true
# Optional fixed public address instead of the tunnel, e.g. https://roundup.example.com
PUBLIC_URL=
