SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
PORT=3000
NUDGE_AFTER_SECONDS=120
GIVE_UP_AFTER_SECONDS=240
DEMO_MODE=true
# Demo seed (npm run seed): two teammates' phones, E.164, both must have texted the agent before
SEED_ORGANIZER_PHONE=
SEED_ORGANIZER_NAME=Priya
